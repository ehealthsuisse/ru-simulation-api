# Template for the .env that docker-compose.yaml reads. Copy it to .env and adjust;
# .env itself is gitignored. The values are the eHealth Suisse preprod ones where known,
# examples otherwise.

# Image built by the pipeline: <registry>/<group>, without the image name
REGISTRY_APP=your.registry/your-image-group
APP_VERSION=1.0.0-SNAPSHOT

# Port the simulator listens on, also used by the healthcheck. 8511 is an example, next to
# hello-gazelle-simulator's 8510: use the port assigned in preprod
QUARKUS_HTTP_PORT=8511

# Public base URL behind the reverse proxy, announced to the service registry
SIMULATIONSERVICEURL=https://pprod-ehealthsuisse.ihe-europe.net/iua-sim-client

HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=30s

MAX_SIZE=10m
MAX_FILE=3

MEM_RESERVATION=256m
MEM_LIMIT=512m
