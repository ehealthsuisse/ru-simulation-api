meta {
  name: 2.1 Simulation Setup
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/simulation/v1/simulations?callback=http://localhost:9090/simulation/v1/report?session=cc-session
  body: json
  auth: none
}

params:query {
  callback: http://localhost:9090/simulation/v1/report?session=cc-session
}

body:json {
  {
    "sequenceId": "001",
    "sequenceIdDefined": true,
    "simulationParameters": [
      {
        "name": "message",
        "type": "TEXT",
        "value": "Hello gazelle simulator!"
      }
    ],
    "timeoutSeconds": 10
  }
}

vars:post-response {
  simulationId: res.body.simulationId
}
